# Se llena automaticamente al conectar la integracion de Neon en Vercel.
DATABASE_URL=

# Contraseña para entrar a la app (la eliges tu, se configura en Vercel > Settings > Environment Variables).
APP_PASSWORD=

# String largo y aleatorio usado para firmar la cookie de sesion (lo generas tu, cualquier valor largo sirve).
SESSION_SECRET=

# Se llena automaticamente al crear el Blob store en Vercel > Storage y conectarlo al proyecto.
BLOB_READ_WRITE_TOKEN=
